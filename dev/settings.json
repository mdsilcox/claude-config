{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoUpdatesChannel": "stable",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.prod*)",
      "Read(//**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)",
      "mcp__basic-memory__write_note",
      "mcp__basic-memory__edit_note",
      "mcp__basic-memory__move_note",
      "mcp__basic-memory__delete_note"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(docker *)",
      "Bash(sudo *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["docker *"],
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.gnupg", "~/.config/gh", "~/.docker", "~/.claude/.credentials.json"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org"
      ]
    }
  },
  "env": {
    "CLAUDE_CODE_TOOL_MEMORY_LIMIT": "3G",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3",
    "VAULT_DIR": "/home/mdsilcox/knowledge-vault-data"
  },
  "statusLine": {
    "type": "command",
    "command": "python3 /home/mdsilcox/.claude/hooks/statusline.py"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "python3 /home/mdsilcox/.claude/hooks/vault_pull.py", "timeout": 20 },
          { "type": "command", "command": "python3 /home/mdsilcox/.claude/hooks/project_setup.py", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 /home/mdsilcox/.claude/hooks/guard_deletes.py", "timeout": 10 },
          { "type": "command", "command": "python3 /home/mdsilcox/.claude/hooks/quiet_tests_hook.py", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 /home/mdsilcox/.claude/hooks/format_on_edit.py", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 /home/mdsilcox/.claude/hooks/stop_gate.py", "timeout": 300 }
        ]
      }
    ]
  }
}
